# Copy to .env and edit. Loaded manually in run scripts (or export in your shell).
SECRET_KEY=change-this-to-a-long-random-string

# --- SQLite (default, no setup) : leave DATABASE_URL unset ---
# --- MySQL example (your SQL server) ---
# DATABASE_URL=mysql+pymysql://dermai_user:StrongPass@localhost:3306/dermai
# --- PostgreSQL example ---
# DATABASE_URL=postgresql+psycopg2://dermai_user:StrongPass@localhost:5432/dermai

# Optional path to trained weights (enables Trained mode instead of Clinical-rule mode)
# WEIGHTS_FILE=models_store/dermai_best.pth
